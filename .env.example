# SpeakUz AI — environment variables
# Copy this file to ".env" and fill in values to enable live AI.
# When these are NOT set, the app runs in transparent demo mode with rule-based fallbacks.

# Live AI configuration (OpenAI-compatible chat completions endpoint)
VITE_AI_PROVIDER=openai
VITE_AI_API_URL=https://api.openai.com/v1/chat/completions
VITE_AI_API_KEY=
VITE_AI_MODEL=gpt-4o-mini
